# Copy to vars.env and fill in. vars.env is git-ignored. NO API keys/tokens here.

# Sudo-capable human admin account (you log in as this).
ADMIN_USER=youruser
# Public key line(s) for ADMIN_USER, e.g. contents of ~/.ssh/id_ed25519.pub
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA... comment"

# Unprivileged account that runs the agent. No sudo, no SSH login, no docker group.
AGENT_USER=hermes

SWAP_GB=2
TIMEZONE=Europe/Rome

# Extra paths to back up besides ~AGENT_USER/.hermes (memory, skills, config). Space-separated.
# Anything else worth backing up, space-separated (e.g. "/home/hermes/work").
BACKUP_EXTRA_PATHS=""

# Install Docker (only if a skill needs it later, e.g. browser sandbox). Agent user is NOT added to the
# docker group (that would be root-equivalent); jobs run via a root-owned wrapper later.
INSTALL_DOCKER=no
