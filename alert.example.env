# Alert channel — copy to /etc/hermes-alert.env on the server (root:root 0600).
# Use a DEDICATED bot (its own token from @BotFather), so alerts are their own chat and
# survive the main bot being down, reconfigured or revoked.
#
# 1. @BotFather -> /newbot -> pick a name and a username ending in "bot"
# 2. Copy the token it prints (looks like 123456789:AA...)
# 3. Open a chat with the new bot and press Start (a bot cannot message you first)
# 4. Put the token below, and your numeric Telegram user id as ALERT_CHAT_ID
#    (the agent can read it back for you with getUpdates if you don't know it)

ALERT_BOT_TOKEN=123456789:AA_EXAMPLE_REPLACE_ME
ALERT_CHAT_ID=000000000
