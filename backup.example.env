# Copy to /etc/hermes-backup.env ON THE SERVER (root:root 0600). Never commit the real one.
# Any S3-compatible bucket works. Examples (repository URL only, then the S3 key pair):
#   Backblaze B2    s3:https://s3.<REGION>.backblazeb2.com/YOUR-BUCKET/hermes
#   Hetzner         s3:https://nbg1.your-objectstorage.com/YOUR-BUCKET/hermes
#   Cloudflare R2   s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/YOUR-BUCKET/hermes
#   AWS S3          s3:s3.eu-south-1.amazonaws.com/YOUR-BUCKET/hermes
#   MinIO (self)    s3:http://127.0.0.1:9000/YOUR-BUCKET/hermes
RESTIC_REPOSITORY=s3:https://s3.REGION.backblazeb2.com/YOUR-BUCKET/hermes
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Long random passphrase; store it in your password manager too.
RESTIC_PASSWORD=
# Optional hardening for a key WITHOUT delete permission (restic normally deletes its own lock
# files, so test this before relying on it; if backup fails, drop it and use a normal key):
# RESTIC_EXTRA_ARGS=--no-lock

# Optional, but it closes the one hole nothing local can: a VPS that is off cannot alert you.
# Dead-man's switch: create a check at https://healthchecks.io (free, 20 checks), copy its ping
# URL here. The backup pings /start when it begins, the bare URL on success and /fail on error.
# If no ping arrives in the period + grace you set there, that service alerts you (email and/or
# Telegram). No model, no tokens: it is one curl. Empty = disabled.
HEARTBEAT_URL=
